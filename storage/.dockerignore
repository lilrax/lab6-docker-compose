
# Исключаем историю Git.
.git
.gitignore

# Не копируем настройки редакторов.
.idea/
.vscode/

# Исключаем локальные виртуальные окружения Python.
.venv/
venv/

# Не копируем временные файлы Python.
__pycache__/
*.pyc
*.pyo

# Исключаем тесты и результаты тестирования.
tests/
.pytest_cache/
.coverage
htmlcov/

# Не копируем кэши инструментов разработки.
.mypy_cache/
.ruff_cache/

# Исключаем локальные настройки и секреты.
.env
.env.*
!.env.example

# Не включаем локальную базу данных SQLite в образ.
# Позже подключим отдельный Docker volume для хранения данных.
data/
*.db
*.db-shm
*.db-wal

# Исключаем журналы и временные файлы.
*.log
*.tmp
