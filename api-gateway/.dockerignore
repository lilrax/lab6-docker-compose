
# Не копируем историю Git в Docker.
.git
.gitignore

# Не копируем виртуальное окружение
.venv/
venv/

# Исключаем временные файлы Python.
__pycache__/
*.pyc
*.pyo

# Исключаем тесты и кэш тестирования.
tests/
.pytest_cache/

# Исключаем результаты проверки типов и линтеров.
.mypy_cache/
.ruff_cache/

# Не включаем локальные секреты и настройки.
.env
.env.*
!.env.example

# Исключаем файлы настроек редакторов.
.idea/
.vscode/

# Исключаем временные файлы и журналы.
*.log
*.tmp
